# Local credentials and environment
/.env
.env.*
!.env.example
!.env.toolchain.example

# 发布私钥和签名描述文件只保存在仓库外；误复制进来时也不纳入 Git。
*.jks
*.keystore
*.p12
*.pfx
AuthKey_*.p8
*.mobileprovision
*.provisionprofile
*.p7b

# 冻结本地引用（只能由 scripts/bootstrap/references.sh 创建）
/examples/

# Rust output
/target/

# Python 开发工具运行缓存
__pycache__/
*.pyc

# Flutter/Dart/OpenHarmony local build metadata
/.dart_tool/
/build/
/.hvigor/
/packages/*/.dart_tool/
**/.flutter-plugins-dependencies
/packages/*/build/
/packages/*/coverage/

# Runtime state and live verification artifacts
session.json
*.session.json
/.ubaa/
/live-artifacts/
/artifacts/live/
*.captcha
*.captcha.*

# UI 验收媒体保存在仓库外；目录中只提交文字、元数据和摘要。
/docs/design/evidence/**/*.png
/docs/design/evidence/**/*.jpg
/docs/design/evidence/**/*.jpeg
/docs/design/evidence/**/*.gif
/docs/design/evidence/**/*.webp
/docs/design/evidence/**/*.bmp
/docs/design/evidence/**/*.tif
/docs/design/evidence/**/*.tiff
/docs/design/evidence/**/*.heic
/docs/design/evidence/**/*.avif
/docs/design/evidence/**/*.mp4
/docs/design/evidence/**/*.mov
/docs/design/evidence/**/*.webm
/docs/design/evidence/**/*.mkv

# Editor and operating-system files
.worktrees/
/.claude/
/.superpowers/
/.serena/
/.codex/
.DS_Store
.idea/
.vscode/
*.swp

# OHOS 构建生成的资源、配置与动态库
/apps/ubaa_ohos/ohos/entry/src/main/resources/rawfile/
/packages/ubaa_bindings/ohos/BuildProfile.ets
/packages/ubaa_bindings/ohos/libs/

# Android Kotlin 编译缓存。
/apps/ubaa_flutter/android/.kotlin/

# VitePress 依赖与构建缓存。
/node_modules/
/docs/site/.vitepress/cache/
/docs/site/.vitepress/dist/

# 项目本地工作区：审计报告、监督记录等不提交的项目资料
/.ubaa_local/

# golden 比较失败时生成的运行截图。
**/test/**/failures/
