# Local credentials and environment
.env.*
!.env.example

# 冻结本地引用（只能由 scripts/bootstrap/references.sh 创建）
/ubaa_old/
/examples/

# Rust output
/target/

# Flutter/OpenHarmony local build metadata
/.hvigor/
/packages/*/.dart_tool/
**/.flutter-plugins-dependencies
/packages/*/build/
/packages/*/coverage/

# Runtime state and live verification artifacts
session.json
*.session.json
/.ubaa/
/live-artifacts/
/artifacts/live/
*.captcha
*.captcha.*

# UI 验收媒体保存在仓库外；目录中只提交文字、元数据和摘要。
/docs/design/evidence/**/*.png
/docs/design/evidence/**/*.jpg
/docs/design/evidence/**/*.jpeg
/docs/design/evidence/**/*.gif
/docs/design/evidence/**/*.webp
/docs/design/evidence/**/*.bmp
/docs/design/evidence/**/*.tif
/docs/design/evidence/**/*.tiff
/docs/design/evidence/**/*.heic
/docs/design/evidence/**/*.avif
/docs/design/evidence/**/*.mp4
/docs/design/evidence/**/*.mov
/docs/design/evidence/**/*.webm
/docs/design/evidence/**/*.mkv

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
