# 复制为仓库根目录 .env，权限设为 600；不要提交填写后的文件。
# 已导出的进程变量优先。公共键支持引号、注释、$HOME 和 ${NAME_WITH_UNDERSCORE}。
# 单引号内不展开变量，配置不会执行 Shell 命令。
# 本地与 CI 使用同名字段。CI 从 Environment Variables/Secrets 注入，不上传本文件。
# 签名参数按平台整组覆盖：进程提供该组任一字段后，不从本文件补齐其他字段。

# 公共工具配置。将占位替换为实际绝对路径；不用 OHOS 时可留空。
UBAA_FLUTTER_HOME="$HOME/<flutter-sdk>"
UBAA_OHOS_FLUTTER_HOME=
# UBAA_DEVECO_HOME="$HOME/<deveco-cli>"
# UBAA_HMOS_SDK_HOME="$HOME/<deveco-cli>/sdk"
# UBAA_OHOS_NODE_HOME="$HOME/<deveco-cli>/tools/node"
# OHOS_SDK_HOME="$HOME/<deveco-cli>/sdk/default/openharmony/native"
# UBAA_FRB_CODEGEN="$HOME/<cargo-bin>/flutter_rust_bridge_codegen"
# UBAA_SHELLCHECK_BIN="$HOME/<tool-bin>/shellcheck"
# UBAA_QUALITY_TOOLS_DIR="$HOME/<quality-tools>"
# UBAA_RELEASE_REPORT_DIR="<private-evidence>/release/run_01"
# UBAA_UI_EVIDENCE_DIR="<private-evidence>/ui/run_01"
# UBAA_FLUTTER_VERBOSE=0
# UBAA_OHOS_NO_CODESIGN=0

# 公共客户端构建配置；任一为空则停用客户端应用服务。
# 渠道可选 github、app_store、app_gallery；CI 按构建矩阵覆盖此值。
UBAA_APP_SERVICE_URL=
UBAA_DISTRIBUTION_CHANNEL=

# 公共 Cloudflare 发布目标；本地检查无需设置。
UBAA_APP_SERVICE_ACCOUNT_ID=
UBAA_APP_SERVICE_WORKER_NAME=
UBAA_APP_SERVICE_D1_ID=
UBAA_APP_SERVICE_KV_NAMESPACE_ID=
UBAA_APP_SERVICE_DOMAIN=

# Android Release 签名。仅 build apk/appbundle 的 Release 模式读取，四项同时填写。
# 签名文件路径以仓库根目录为基准，也可使用绝对路径；密码和别名按字面读取。
# ANDROID_STORE_FILE=.sign/android/release/release.jks
# ANDROID_STORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# OHOS Release 签名。仅 build hap/app 的对应模式读取，六项同时填写。
# OHOS_STORE_FILE=.sign/ohos/release.p12
# OHOS_STORE_PASSWORD=
# OHOS_KEY_ALIAS=
# OHOS_KEY_PASSWORD=
# OHOS_CERT_FILE=.sign/ohos/release.cer
# OHOS_PROFILE_FILE=.sign/ohos/release.p7b
# OHOS_SIGN_ALG=SHA256withECDSA
# 如需签名 Debug 包，另外配置 OHOS_DEBUG_STORE_FILE、OHOS_DEBUG_STORE_PASSWORD、
# OHOS_DEBUG_KEY_ALIAS、OHOS_DEBUG_KEY_PASSWORD、OHOS_DEBUG_CERT_FILE、OHOS_DEBUG_PROFILE_FILE，
# 可选 OHOS_DEBUG_SIGN_ALG。Debug 与 Release 材料独立；--no-codesign 不读取签名参数。

# 仅 verify-live 读取学校账号，按字面值解析并经 stdin 传给 Core-live。
UBAA_TEST_USERNAME=
UBAA_TEST_PASSWORD=
# 兼容名称，主名称为空时回退：
# UBAA_USERNAME=
# UBAA_PASSWORD=

# 仅 app-service-deploy、app-service-publish 读取此 Token，按字面值解析。
CLOUDFLARE_API_TOKEN=

# 受 Git 管理的配置：
# 渠道最新版本、最低支持版本、下载地址：services/app_service/config/channels.json。
# 公告正文：docs/site/announcements/；工具链版本：scripts/tools/versions.env。
# 正式应用版本：宿主 pubspec.yaml 和平台版本声明；分支触发规则：.github/workflows/。
# Apple 签名使用 Keychain/Xcode 原生配置，见 docs/runbooks/app-signing.md。
# R2、商店上传尚无项目入口，暂不定义环境变量。

# 下列真实验证参数由调用方通过进程环境传入，不从 .env 读取：
# UBAA_VERIFY_DATE=2026-10-29
# UBAA_VERIFY_CAMPUS_ID=1
# UBAA_CONFIG_DIR="<private-evidence>/live/config"
# UBAA_CORE_LIVE_BUILD=no
# 其他进程参数、dart-define 和测试内部变量见 docs/development/setup.md。
