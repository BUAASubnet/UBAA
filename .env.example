# 仅显式真实验证入口读取此文件中的凭据；普通检查不需要凭据。
# 复制为被忽略的 .env.local 后填写，不提交值。
UBAA_TEST_USERNAME=
UBAA_TEST_PASSWORD=
# 兼容旧名称 UBAA_USERNAME / UBAA_PASSWORD；新配置使用上面的主名称。
# 工具路径另见 .env.toolchain.example，工具入口绝不加载此凭据文件。
# 显式真实验证的可选参数由调用方传入：
# UBAA_ENV_FILE="<repo-root>/.env.local"
# UBAA_VERIFY_DATE=2026-10-29
# UBAA_VERIFY_CAMPUS_ID=1
# UBAA_CONFIG_DIR="<private-evidence>/live/config"
# UBAA_CORE_LIVE_BUILD=no
# 其他环境变量、dart-define 和测试内部变量见 docs/development/setup.md。
