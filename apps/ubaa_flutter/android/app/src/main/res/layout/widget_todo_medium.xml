<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/widget_root" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="@dimen/widget_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/widget_title" android:includeFontPadding="false" android:textSize="13sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="1" android:text="@string/widget_todo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/widget_footer" android:includeFontPadding="false" android:textSize="10sp" android:textColor="@color/widget_tertiary" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_slot_1" android:layout_weight="1" android:layout_marginTop="3dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_slot_2" android:layout_weight="1" android:layout_marginTop="3dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_slot_3" android:layout_weight="1" android:layout_marginTop="3dp" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_message" android:includeFontPadding="false" android:textSize="14sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="@string/widget_load_todo" android:layout_marginTop="6dp" />
</LinearLayout>
