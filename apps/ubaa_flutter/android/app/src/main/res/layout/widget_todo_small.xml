<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/widget_root" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="@dimen/widget_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_title" android:includeFontPadding="false" android:textSize="13sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="@string/widget_todo" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_time" android:includeFontPadding="false" android:textSize="16sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_item_title" android:includeFontPadding="false" android:textSize="14sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_sub" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_message" android:includeFontPadding="false" android:textSize="14sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="@string/widget_load_todo" android:layout_marginTop="6dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_footer_spacer" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_footer" android:includeFontPadding="false" android:textSize="10sp" android:textColor="@color/widget_tertiary" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
