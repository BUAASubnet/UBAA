<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/widget_row" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:id="@+id/widget_time" android:includeFontPadding="false" android:textSize="13sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="end" android:layout_marginEnd="6dp" />
    <FrameLayout android:layout_width="3dp" android:layout_height="match_parent" android:id="@+id/widget_bar" android:layout_marginEnd="6dp" android:background="@color/widget_accent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_item_title" android:includeFontPadding="false" android:textSize="14sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_sub" android:includeFontPadding="false" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
