<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/widget_root" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="@dimen/widget_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/widget_week_header_height" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/widget_title" android:includeFontPadding="false" android:textSize="15sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="1" android:text="@string/widget_week" />
        <TextView android:layout_width="32dp" android:layout_height="match_parent" android:id="@+id/widget_previous" android:includeFontPadding="false" android:textSize="24sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:text="‹" android:gravity="center" android:contentDescription="@string/widget_week_previous" android:visibility="gone" />
        <TextView android:layout_width="32dp" android:layout_height="match_parent" android:id="@+id/widget_next" android:includeFontPadding="false" android:textSize="24sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:text="›" android:gravity="center" android:contentDescription="@string/widget_week_next" android:visibility="gone" />
        <TextView android:layout_width="32dp" android:layout_height="match_parent" android:id="@+id/widget_current" android:includeFontPadding="false" android:textSize="13sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_week_current_button" android:gravity="center" android:contentDescription="@string/widget_week_current" android:visibility="gone" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_message" android:includeFontPadding="false" android:textSize="15sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:text="@string/widget_missing" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_hint" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_load_schedule" />
    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/widget_grid" android:layout_weight="1" android:visibility="gone" android:scaleType="fitCenter" />
</LinearLayout>
