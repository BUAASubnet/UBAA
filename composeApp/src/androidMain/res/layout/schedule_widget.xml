<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/schedule_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_previous" android:layout_width="32dp" android:layout_height="32dp"
            android:text="‹" android:textSize="24sp" android:textColor="#244C86" android:gravity="center" android:contentDescription="上一周" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="UBAA 周课表" android:textSize="13sp" android:textStyle="bold" android:textColor="#18304B" android:gravity="center" android:maxLines="2" />
        <TextView android:id="@+id/widget_next" android:layout_width="32dp" android:layout_height="32dp"
            android:text="›" android:textSize="24sp" android:textColor="#244C86" android:gravity="center" android:contentDescription="下一周" />
        <TextView android:id="@+id/widget_current" android:layout_width="32dp" android:layout_height="32dp"
            android:text="本周" android:textSize="13sp" android:textColor="#244C86" android:gravity="center" android:contentDescription="回到本周" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#42546A" android:text="请先打开 UBAA，登录并更新课表" />
    <ImageView android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone" android:scaleType="fitXY" android:contentDescription="本地周课表，点击查看详情" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="16dp"
        android:gravity="center" android:text="本地课表 · 点击查看整周" android:textSize="10sp" android:textColor="#53647A" android:maxLines="1" />
</LinearLayout>
