{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BUAASubnet/UBAA/docs/contracts/cli-json.schema.json",
  "title": "UBAA CLI JSON envelope",
  "oneOf": [
    { "$ref": "#/$defs/resolvedRoutedEnvelope" },
    { "$ref": "#/$defs/unresolvedRoutedFailure" },
    { "$ref": "#/$defs/aggregateAuthEnvelope" },
    { "$ref": "#/$defs/aggregateLogoutEnvelope" }
  ],
  "$defs": {
    "feature": {
      "enum": ["cli", "auth", "user", "schedule", "exam", "grades", "classroom", "spoc", "judge", "signin", "libbook", "ygdk"]
    },
    "route": {
      "enum": ["direct", "webvpn"]
    },
    "routePolicy": {
      "enum": ["auto", "direct", "webvpn"]
    },
    "networkState": {
      "enum": ["campus", "off_campus", "unknown"]
    },
    "errorCode": {
      "enum": [
        "invalid_input",
        "authentication_required",
        "invalid_credentials",
        "password_risk_confirmation_failed",
        "permission_denied",
        "network_error",
        "timeout",
        "upstream_unavailable",
        "upstream_changed",
        "parse_error",
        "internal_error"
      ]
    },
    "errorKind": {
      "enum": ["input", "authentication", "network", "upstream", "parse", "internal"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "maskedSensitive": {
      "type": ["string", "null"],
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(?:\\*{0,4}|..\\*+..)$" }
      ]
    },
    "i32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "nonnegativeI32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "i64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "jsonSafeUsize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "userProfile": {
      "type": "object",
      "required": ["idCardType", "idCardTypeName", "phone", "schoolId", "name", "idCardNumber", "email", "username"],
      "properties": {
        "idCardType": { "type": ["string", "null"] },
        "idCardTypeName": { "type": ["string", "null"] },
        "phone": { "$ref": "#/$defs/maskedSensitive" },
        "schoolId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "idCardNumber": { "$ref": "#/$defs/maskedSensitive" },
        "email": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "authStatus": {
      "type": "object",
      "required": ["user", "authenticatedAt", "lastActivity"],
      "properties": {
        "user": { "$ref": "#/$defs/userProfile" },
        "authenticatedAt": { "$ref": "#/$defs/i64" },
        "lastActivity": { "$ref": "#/$defs/i64" }
      },
      "additionalProperties": false
    },
    "routedLogoutData": {
      "type": "object",
      "required": ["loggedOut"],
      "properties": {
        "loggedOut": { "const": true }
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["itemCode", "itemName", "selected", "itemIndex"],
      "properties": {
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "selected": { "type": "boolean" },
        "itemIndex": { "$ref": "#/$defs/i32" }
      },
      "additionalProperties": false
    },
    "week": {
      "type": "object",
      "required": ["startDate", "endDate", "term", "curWeek", "serialNumber", "name"],
      "properties": {
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "term": { "type": "string" },
        "curWeek": { "type": "boolean" },
        "serialNumber": { "$ref": "#/$defs/i32" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "courseClass": {
      "type": "object",
      "required": ["courseCode", "courseName", "courseSerialNo", "credit", "beginTime", "endTime", "beginSection", "endSection", "placeName", "weeksAndTeachers", "teachingTarget", "color", "dayOfWeek"],
      "properties": {
        "courseCode": { "type": "string" },
        "courseName": { "type": "string" },
        "courseSerialNo": { "$ref": "#/$defs/nullableString" },
        "credit": { "$ref": "#/$defs/nullableString" },
        "beginTime": { "$ref": "#/$defs/nullableString" },
        "endTime": { "$ref": "#/$defs/nullableString" },
        "beginSection": { "anyOf": [{ "$ref": "#/$defs/i32" }, { "type": "null" }] },
        "endSection": { "anyOf": [{ "$ref": "#/$defs/i32" }, { "type": "null" }] },
        "placeName": { "$ref": "#/$defs/nullableString" },
        "weeksAndTeachers": { "$ref": "#/$defs/nullableString" },
        "teachingTarget": { "$ref": "#/$defs/nullableString" },
        "color": { "$ref": "#/$defs/nullableString" },
        "dayOfWeek": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 7 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "weeklySchedule": {
      "type": "object",
      "required": ["arrangedList", "code", "name"],
      "properties": {
        "arrangedList": { "type": "array", "items": { "$ref": "#/$defs/courseClass" } },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "todayClass": {
      "type": "object",
      "required": ["bizName", "place", "time", "shortName"],
      "properties": {
        "bizName": { "type": "string" },
        "place": { "$ref": "#/$defs/nullableString" },
        "time": { "$ref": "#/$defs/nullableString" },
        "shortName": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "signinClass": {
      "type": "object",
      "required": ["courseId", "courseName", "classBeginTime", "classEndTime", "signStatus"],
      "properties": {
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "classBeginTime": { "type": "string" },
        "classEndTime": { "type": "string" },
        "signStatus": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "libBookLibrary": {
      "type": "object",
      "required": ["id", "name", "freeNum", "totalNum", "storeys"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "freeNum": { "$ref": "#/$defs/i32" },
        "totalNum": { "$ref": "#/$defs/i32" },
        "storeys": { "type": "array", "items": { "$ref": "#/$defs/libBookStorey" } }
      },
      "additionalProperties": false
    },
    "libBookStorey": {
      "type": "object",
      "required": ["id", "name", "freeNum", "totalNum"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "freeNum": { "$ref": "#/$defs/i32" }, "totalNum": { "$ref": "#/$defs/i32" }
      },
      "additionalProperties": false
    },
    "libBookArea": {
      "type": "object",
      "required": ["id", "name", "areaName", "premisesId", "storeyId", "freeNum", "totalNum"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "areaName": { "type": "string" },
        "premisesId": { "type": "string" }, "storeyId": { "type": "string" },
        "freeNum": { "$ref": "#/$defs/i32" }, "totalNum": { "$ref": "#/$defs/i32" }
      },
      "additionalProperties": false
    },
    "libBookTimeSlot": {
      "type": "object",
      "required": ["id", "start", "end", "label"],
      "properties": {
        "id": { "type": "string" }, "start": { "type": "string" },
        "end": { "type": "string" }, "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "libBookAreaDetail": {
      "type": "object",
      "required": ["id", "name", "availableDates", "timeSlots"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "availableDates": { "type": "array", "items": { "type": "string" } },
        "timeSlots": { "type": "array", "items": { "$ref": "#/$defs/libBookTimeSlot" } }
      },
      "additionalProperties": false
    },
    "libBookSeat": {
      "type": "object",
      "required": ["id", "name", "no", "status", "statusName", "isAvailable"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "no": { "type": "string" },
        "status": { "type": "string" }, "statusName": { "type": "string" }, "isAvailable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "libBookBooking": {
      "type": "object",
      "required": ["id", "nameMerge", "areaName", "seatNo", "day", "beginTime", "endTime", "status", "statusName"],
      "properties": {
        "id": { "type": "string" }, "nameMerge": { "type": "string" }, "areaName": { "type": "string" },
        "seatNo": { "type": "string" }, "day": { "type": "string" }, "beginTime": { "type": "string" },
        "endTime": { "type": "string" }, "status": { "type": "string" }, "statusName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "libBookBookingsPage": {
      "type": "object",
      "required": ["bookings", "page", "limit", "total"],
      "properties": {
        "bookings": { "type": "array", "items": { "$ref": "#/$defs/libBookBooking" } },
        "page": { "$ref": "#/$defs/i32" }, "limit": { "$ref": "#/$defs/i32" }, "total": { "$ref": "#/$defs/i32" }
      },
      "additionalProperties": false
    },
    "libBookRoutedData": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/libBookLibrary" } },
        { "type": "array", "items": { "$ref": "#/$defs/libBookArea" } },
        { "$ref": "#/$defs/libBookAreaDetail" },
        { "type": "array", "items": { "$ref": "#/$defs/libBookSeat" } },
        { "$ref": "#/$defs/libBookBookingsPage" }
      ]
    },
    "ygdkOverview": {
      "type": "object",
      "required": ["summary", "classifyId", "classifyName", "defaultItemId", "defaultItemName", "items"],
      "properties": {
        "summary": { "$ref": "#/$defs/ygdkTermSummary" },
        "classifyId": { "type": "integer" },
        "classifyName": { "type": "string" },
        "defaultItemId": { "type": "integer" },
        "defaultItemName": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ygdkItem" } }
      },
      "additionalProperties": false
    },
    "ygdkTermSummary": {
      "type": "object",
      "required": ["termId", "termName", "termCount", "termTarget", "weekCount", "weekTarget", "monthCount", "monthTarget", "dayCount", "goodCount"],
      "properties": {
        "termId": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "termName": { "$ref": "#/$defs/nullableString" }, "termCount": { "type": "integer" }, "termTarget": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "weekCount": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "weekTarget": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "monthCount": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "monthTarget": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "dayCount": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "goodCount": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }, "additionalProperties": false
    },
    "ygdkItem": {
      "type": "object", "required": ["itemId", "name", "kind", "sort"],
      "properties": { "itemId": { "type": "integer" }, "name": { "type": "string" }, "kind": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "sort": { "anyOf": [{ "type": "integer" }, { "type": "null" }] } }, "additionalProperties": false
    },
    "ygdkRecord": {
      "type": "object", "required": ["recordId", "itemId", "itemName", "startTime", "endTime", "place", "images", "isOpen", "state", "createdAt", "createdAtLabel"],
      "properties": { "recordId": { "type": "integer" }, "itemId": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "itemName": { "$ref": "#/$defs/nullableString" }, "startTime": { "$ref": "#/$defs/nullableString" }, "endTime": { "$ref": "#/$defs/nullableString" }, "place": { "$ref": "#/$defs/nullableString" }, "images": { "type": "array", "items": { "type": "string" } }, "isOpen": { "type": "boolean" }, "state": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "createdAt": { "$ref": "#/$defs/nullableString" }, "createdAtLabel": { "$ref": "#/$defs/nullableString" } }, "additionalProperties": false
    },
    "ygdkRecordsPage": {
      "type": "object", "required": ["content", "total", "page", "size", "hasMore"],
      "properties": { "content": { "type": "array", "items": { "$ref": "#/$defs/ygdkRecord" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "size": { "type": "integer" }, "hasMore": { "type": "boolean" } }, "additionalProperties": false
    },
    "exam": {
      "type": "object",
      "required": ["courseName", "courseNo", "examTimeDescription", "examDate", "startTime", "endTime", "examPlace", "examSeatNo", "week", "examStatus", "examType", "taskId"],
      "properties": {
        "courseName": { "type": "string" },
        "courseNo": { "$ref": "#/$defs/nullableString" },
        "examTimeDescription": { "$ref": "#/$defs/nullableString" },
        "examDate": { "$ref": "#/$defs/nullableString" },
        "startTime": { "$ref": "#/$defs/nullableString" },
        "endTime": { "$ref": "#/$defs/nullableString" },
        "examPlace": { "$ref": "#/$defs/nullableString" },
        "examSeatNo": { "$ref": "#/$defs/nullableString" },
        "week": { "anyOf": [{ "$ref": "#/$defs/i32" }, { "type": "null" }] },
        "examStatus": { "anyOf": [{ "$ref": "#/$defs/i32" }, { "type": "null" }] },
        "examType": { "$ref": "#/$defs/nullableString" },
        "taskId": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "examArrangement": {
      "type": "object",
      "required": ["arranged", "notArranged"],
      "properties": {
        "arranged": { "type": "array", "items": { "$ref": "#/$defs/exam" } },
        "notArranged": { "type": "array", "items": { "$ref": "#/$defs/exam" } }
      },
      "additionalProperties": false
    },
    "grade": {
      "type": "object",
      "required": ["courseName", "courseCode", "credit", "score", "gradePoint", "courseType", "scoreType", "termCode"],
      "properties": {
        "courseName": { "$ref": "#/$defs/nullableString" },
        "courseCode": { "$ref": "#/$defs/nullableString" },
        "credit": { "type": ["number", "null"] },
        "score": { "$ref": "#/$defs/nullableString" },
        "gradePoint": { "$ref": "#/$defs/nullableString" },
        "courseType": { "$ref": "#/$defs/nullableString" },
        "scoreType": { "$ref": "#/$defs/nullableString" },
        "termCode": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "gradeData": {
      "type": "object",
      "required": ["termCode", "grades"],
      "properties": {
        "termCode": { "type": "string" },
        "grades": { "type": "array", "items": { "$ref": "#/$defs/grade" } }
      },
      "additionalProperties": false
    },
    "classroomInfo": {
      "type": "object",
      "required": ["id", "floorId", "name", "availableSections"],
      "properties": {
        "id": { "type": "string" },
        "floorId": { "type": "string" },
        "name": { "type": "string" },
        "availableSections": { "type": "string" }
      },
      "additionalProperties": false
    },
    "classroomQuery": {
      "type": "object",
      "required": ["code", "message", "floors"],
      "properties": {
        "code": { "$ref": "#/$defs/i32" },
        "message": { "type": "string" },
        "floors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/classroomInfo" }
          }
        }
      },
      "additionalProperties": false
    },
    "spocStatus": {
      "enum": ["SUBMITTED", "UNSUBMITTED", "UNKNOWN"]
    },
    "spocAssignmentSummary": {
      "type": "object",
      "required": ["assignmentId", "courseId", "courseName", "teacherName", "title", "startTime", "dueTime", "score", "submissionStatus", "submissionStatusText"],
      "properties": {
        "assignmentId": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "teacherName": { "$ref": "#/$defs/nullableString" },
        "title": { "type": "string" },
        "startTime": { "$ref": "#/$defs/nullableString" },
        "dueTime": { "$ref": "#/$defs/nullableString" },
        "score": { "$ref": "#/$defs/nullableString" },
        "submissionStatus": { "$ref": "#/$defs/spocStatus" },
        "submissionStatusText": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "submissionStatus": { "const": "SUBMITTED" } }, "required": ["submissionStatus"] },
          "then": { "properties": { "submissionStatusText": { "const": "已提交" } } }
        },
        {
          "if": { "properties": { "submissionStatus": { "const": "UNSUBMITTED" } }, "required": ["submissionStatus"] },
          "then": { "properties": { "submissionStatusText": { "const": "未提交" } } }
        },
        {
          "if": { "properties": { "submissionStatus": { "const": "UNKNOWN" } }, "required": ["submissionStatus"] },
          "then": {
            "properties": {
              "submissionStatusText": {
                "pattern": "^未知状态\\(.+\\)$",
                "not": { "enum": ["未知状态(1)", "未知状态(已做)", "未知状态(已提交)", "未知状态(0)", "未知状态(未做)", "未知状态(未提交)"] }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "spocAssignments": {
      "type": "object",
      "required": ["termCode", "termName", "assignments"],
      "properties": {
        "termCode": { "type": "string" },
        "termName": { "$ref": "#/$defs/nullableString" },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/spocAssignmentSummary" } }
      },
      "additionalProperties": false
    },
    "spocAssignmentsDiagnostics": {
      "type": "object",
      "required": ["globalPageCount", "result"],
      "properties": {
        "globalPageCount": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "result": { "$ref": "#/$defs/spocAssignments" }
      },
      "additionalProperties": false
    },
    "spocAssignmentDetail": {
      "type": "object",
      "required": ["assignmentId", "courseId", "courseName", "teacherName", "title", "startTime", "dueTime", "score", "submissionStatus", "submissionStatusText", "contentPlainText", "submittedAt"],
      "properties": {
        "assignmentId": { "type": "string" },
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "teacherName": { "$ref": "#/$defs/nullableString" },
        "title": { "type": "string" },
        "startTime": { "$ref": "#/$defs/nullableString" },
        "dueTime": { "$ref": "#/$defs/nullableString" },
        "score": { "$ref": "#/$defs/nullableString" },
        "submissionStatus": { "$ref": "#/$defs/spocStatus" },
        "submissionStatusText": { "type": "string" },
        "contentPlainText": { "$ref": "#/$defs/nullableString" },
        "submittedAt": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "submissionStatus": { "const": "SUBMITTED" } }, "required": ["submissionStatus"] },
          "then": { "properties": { "submissionStatusText": { "const": "已提交" } } }
        },
        {
          "if": { "properties": { "submissionStatus": { "const": "UNSUBMITTED" } }, "required": ["submissionStatus"] },
          "then": { "properties": { "submissionStatusText": { "const": "未提交" } } }
        },
        {
          "if": { "properties": { "submissionStatus": { "const": "UNKNOWN" } }, "required": ["submissionStatus"] },
          "then": {
            "properties": {
              "submissionStatusText": {
                "anyOf": [
                  { "const": "未知状态" },
                  {
                    "pattern": "^未知状态\\(.+\\)$",
                    "not": { "enum": ["未知状态(1)", "未知状态(已做)", "未知状态(已提交)", "未知状态(0)", "未知状态(未做)", "未知状态(未提交)"] }
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "judgeStatus": {
      "enum": ["SUBMITTED", "PARTIAL", "UNSUBMITTED", "UNKNOWN"]
    },
    "judgeProblemStatus": {
      "enum": ["SUBMITTED", "UNSUBMITTED"]
    },
    "judgeCourseId": {
      "type": "string",
      "pattern": "^\\p{Nd}+$",
      "not": { "const": "0" }
    },
    "judgeAssignmentId": {
      "type": "string",
      "pattern": "^\\p{Nd}+$"
    },
    "judgeScore": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "judgeAssignmentSummary": {
      "type": "object",
      "required": ["courseId", "courseName", "assignmentId", "title", "startTime", "dueTime", "maxScore", "myScore", "totalProblems", "submittedCount", "submissionStatus", "submissionStatusText"],
      "properties": {
        "courseId": { "$ref": "#/$defs/judgeCourseId" },
        "courseName": { "type": "string" },
        "assignmentId": { "$ref": "#/$defs/judgeAssignmentId" },
        "title": { "type": "string" },
        "startTime": { "$ref": "#/$defs/nullableString" },
        "dueTime": { "$ref": "#/$defs/nullableString" },
        "maxScore": { "$ref": "#/$defs/judgeScore" },
        "myScore": { "$ref": "#/$defs/judgeScore" },
        "totalProblems": { "$ref": "#/$defs/nonnegativeI32" },
        "submittedCount": { "$ref": "#/$defs/nonnegativeI32" },
        "submissionStatus": { "$ref": "#/$defs/judgeStatus" },
        "submissionStatusText": { "type": "string" }
      },
      "additionalProperties": false
    },
    "judgeProblem": {
      "type": "object",
      "required": ["name", "score", "maxScore", "status", "statusText"],
      "properties": {
        "name": { "type": "string" },
        "score": { "$ref": "#/$defs/judgeScore" },
        "maxScore": { "$ref": "#/$defs/judgeScore" },
        "status": { "$ref": "#/$defs/judgeProblemStatus" },
        "statusText": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "SUBMITTED" } }, "required": ["status"] },
          "then": { "properties": { "statusText": { "const": "已提交" } } }
        },
        {
          "if": { "properties": { "status": { "const": "UNSUBMITTED" } }, "required": ["status"] },
          "then": { "properties": { "statusText": { "const": "未提交" } } }
        }
      ],
      "additionalProperties": false
    },
    "judgeAssignmentDetail": {
      "type": "object",
      "required": ["courseId", "courseName", "assignmentId", "title", "startTime", "dueTime", "maxScore", "myScore", "totalProblems", "submittedCount", "submissionStatus", "submissionStatusText", "problems", "contentPlainText"],
      "properties": {
        "courseId": { "$ref": "#/$defs/judgeCourseId" },
        "courseName": { "type": "string" },
        "assignmentId": { "$ref": "#/$defs/judgeAssignmentId" },
        "title": { "type": "string" },
        "startTime": { "$ref": "#/$defs/nullableString" },
        "dueTime": { "$ref": "#/$defs/nullableString" },
        "maxScore": { "$ref": "#/$defs/judgeScore" },
        "myScore": { "$ref": "#/$defs/judgeScore" },
        "totalProblems": { "$ref": "#/$defs/nonnegativeI32" },
        "submittedCount": { "$ref": "#/$defs/nonnegativeI32" },
        "submissionStatus": { "$ref": "#/$defs/judgeStatus" },
        "submissionStatusText": { "type": "string" },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/judgeProblem" } },
        "contentPlainText": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "judgeAssignmentsDiagnostics": {
      "type": "object",
      "required": ["courseCount", "rawAnchorCount", "filteredUniqueCount", "summaries"],
      "properties": {
        "courseCount": { "$ref": "#/$defs/jsonSafeUsize" },
        "rawAnchorCount": { "$ref": "#/$defs/jsonSafeUsize" },
        "filteredUniqueCount": { "$ref": "#/$defs/jsonSafeUsize" },
        "summaries": { "type": "array", "items": { "$ref": "#/$defs/judgeAssignmentSummary" } }
      },
      "additionalProperties": false
    },
    "authRoutedData": {
      "anyOf": [
        { "$ref": "#/$defs/userProfile" },
        { "$ref": "#/$defs/authStatus" },
        { "$ref": "#/$defs/routedLogoutData" }
      ]
    },
    "scheduleRoutedData": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/term" } },
        { "type": "array", "items": { "$ref": "#/$defs/week" } },
        { "$ref": "#/$defs/weeklySchedule" },
        { "type": "array", "items": { "$ref": "#/$defs/todayClass" } }
      ]
    },
    "spocRoutedData": {
      "anyOf": [
        { "$ref": "#/$defs/spocAssignments" },
        { "$ref": "#/$defs/spocAssignmentsDiagnostics" },
        { "$ref": "#/$defs/spocAssignmentDetail" }
      ]
    },
    "judgeRoutedData": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/judgeAssignmentSummary" } },
        { "$ref": "#/$defs/judgeAssignmentsDiagnostics" },
        { "$ref": "#/$defs/judgeAssignmentDetail" },
        { "type": "array", "items": { "$ref": "#/$defs/judgeAssignmentDetail" } }
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "kind", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "kind": { "$ref": "#/$defs/errorKind" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "safeError": {
      "type": "object",
      "required": ["code", "kind", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "kind": { "$ref": "#/$defs/errorKind" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resolvedRoutedMeta": {
      "type": "object",
      "required": ["routePolicy", "networkState", "initialRoute", "resolvedRoute", "usedFallback", "feature"],
      "properties": {
        "routePolicy": { "$ref": "#/$defs/routePolicy" },
        "networkState": { "$ref": "#/$defs/networkState" },
        "initialRoute": { "$ref": "#/$defs/route" },
        "resolvedRoute": { "$ref": "#/$defs/route" },
        "usedFallback": { "type": "boolean" },
        "feature": { "$ref": "#/$defs/feature" }
      },
      "additionalProperties": false
    },
    "unresolvedRoutedMeta": {
      "type": "object",
      "required": ["feature"],
      "properties": {
        "feature": { "$ref": "#/$defs/feature" }
      },
      "additionalProperties": false
    },
    "resolvedRoutedEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "ok", "meta"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "ok": { "type": "boolean" },
        "data": {},
        "error": { "$ref": "#/$defs/error" },
        "meta": { "$ref": "#/$defs/resolvedRoutedMeta" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "required": ["data"],
            "not": { "required": ["error"] }
          },
          "else": {
            "required": ["error"],
            "not": { "required": ["data"] }
          }
        },
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "auth" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/authRoutedData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "user" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/userProfile" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "schedule" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/scheduleRoutedData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "exam" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/examArrangement" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "grades" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/gradeData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "classroom" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/classroomQuery" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "spoc" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/spocRoutedData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "judge" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/judgeRoutedData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "signin" } }, "required": ["feature"] },
                  "data": { "type": "array", "items": { "$ref": "#/$defs/signinClass" } }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "libbook" } }, "required": ["feature"] },
                  "data": { "$ref": "#/$defs/libBookRoutedData" }
                }
              },
              {
                "properties": {
                  "meta": { "properties": { "feature": { "const": "ygdk" } }, "required": ["feature"] },
                  "data": { "oneOf": [{ "$ref": "#/$defs/ygdkOverview" }, { "$ref": "#/$defs/ygdkRecordsPage" }] }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "ok": { "const": false } },
            "required": ["ok"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "meta": {
                    "properties": { "feature": { "not": { "const": "auth" } } },
                    "required": ["feature"]
                  },
                  "error": { "$ref": "#/$defs/error" }
                }
              },
              {
                "properties": {
                  "meta": {
                    "properties": { "feature": { "const": "auth" } },
                    "required": ["feature"]
                  },
                  "error": { "$ref": "#/$defs/error" }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "unresolvedRoutedFailure": {
      "type": "object",
      "required": ["schemaVersion", "ok", "error", "meta"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" },
        "meta": { "$ref": "#/$defs/unresolvedRoutedMeta" }
      },
      "additionalProperties": false
    },
    "routeResult": {
      "type": "object",
      "required": ["route", "state"],
      "properties": {
        "route": { "$ref": "#/$defs/route" },
        "state": { "enum": ["ready", "failed"] },
        "error": { "$ref": "#/$defs/safeError" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "ready" } },
            "required": ["state"]
          },
          "then": { "not": { "required": ["error"] } }
        },
        {
          "if": {
            "properties": { "state": { "const": "failed" } },
            "required": ["state"]
          },
          "then": {
            "required": ["error"],
            "properties": {
              "error": { "$ref": "#/$defs/safeError" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "directRouteResult": {
      "allOf": [
        { "$ref": "#/$defs/routeResult" },
        { "properties": { "route": { "const": "direct" } } }
      ]
    },
    "webvpnRouteResult": {
      "allOf": [
        { "$ref": "#/$defs/routeResult" },
        { "properties": { "route": { "const": "webvpn" } } }
      ]
    },
    "routePair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/directRouteResult" },
        { "$ref": "#/$defs/webvpnRouteResult" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "aggregateAuthData": {
      "type": "object",
      "required": ["readiness", "routes"],
      "properties": {
        "readiness": { "enum": ["all_ready", "partial", "none_ready"] },
        "routes": { "$ref": "#/$defs/routePair" },
        "profile": { "$ref": "#/$defs/userProfile" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "readiness": { "const": "all_ready" } },
            "required": ["readiness"]
          },
          "then": {
            "required": ["profile"],
            "properties": {
              "routes": {
                "prefixItems": [
                  { "properties": { "state": { "const": "ready" } } },
                  { "properties": { "state": { "const": "ready" } } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "readiness": { "const": "partial" } },
            "required": ["readiness"]
          },
          "then": {
            "required": ["profile"],
            "properties": {
              "routes": {
                "oneOf": [
                  {
                    "prefixItems": [
                      { "properties": { "state": { "const": "ready" } } },
                      { "properties": { "state": { "const": "failed" } } }
                    ]
                  },
                  {
                    "prefixItems": [
                      { "properties": { "state": { "const": "failed" } } },
                      { "properties": { "state": { "const": "ready" } } }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "readiness": { "const": "none_ready" } },
            "required": ["readiness"]
          },
          "then": {
            "not": { "required": ["profile"] },
            "properties": {
              "routes": {
                "prefixItems": [
                  { "properties": { "state": { "const": "failed" } } },
                  { "properties": { "state": { "const": "failed" } } }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "aggregateMeta": {
      "type": "object",
      "required": ["routePolicy", "resolvedRoutes", "feature"],
      "properties": {
        "routePolicy": { "$ref": "#/$defs/routePolicy" },
        "resolvedRoutes": {
          "type": "array",
          "prefixItems": [
            { "const": "direct" },
            { "const": "webvpn" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "feature": { "const": "auth" }
      },
      "additionalProperties": false
    },
    "aggregateAuthEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "ok", "data", "meta"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "ok": { "type": "boolean" },
        "data": { "$ref": "#/$defs/aggregateAuthData" },
        "error": { "$ref": "#/$defs/error" },
        "meta": { "$ref": "#/$defs/aggregateMeta" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "not": { "required": ["error"] },
            "properties": {
              "data": {
                "properties": {
                  "readiness": { "enum": ["all_ready", "partial"] }
                }
              }
            }
          },
          "else": {
            "required": ["error"],
            "properties": {
              "data": {
                "properties": {
                  "readiness": { "const": "none_ready" }
                }
              },
              "error": { "$ref": "#/$defs/error" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "aggregateLogoutRoutePair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "required": ["route", "state"],
          "properties": {
            "route": { "const": "direct" },
            "state": { "const": "logged_out" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["route", "state"],
          "properties": {
            "route": { "const": "webvpn" },
            "state": { "const": "logged_out" }
          },
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "aggregateLogoutData": {
      "type": "object",
      "required": ["loggedOut", "routes"],
      "properties": {
        "loggedOut": { "const": true },
        "routes": { "$ref": "#/$defs/aggregateLogoutRoutePair" }
      },
      "additionalProperties": false
    },
    "aggregateLogoutEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "ok", "data", "meta"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "ok": { "const": true },
        "data": { "$ref": "#/$defs/aggregateLogoutData" },
        "meta": { "$ref": "#/$defs/aggregateMeta" }
      },
      "additionalProperties": false
    }
  }
}
